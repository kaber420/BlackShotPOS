# ==========================================
# Configuración de Entorno Ejemplar (Template)
# ==========================================
# Copia este archivo y renómbralo a `.env` 
# luego reemplaza los valores antes de correr la API o pasar a producción.

# ---------------------------------------------------------
# Base de Datos
# ---------------------------------------------------------
# URL de conexión a la base de datos de SQLAlchemy (PostgreSQL).
DATABASE_URL="postgresql+asyncpg://usuario:contraseña@localhost:5432/blackshot_db"


# ---------------------------------------------------------
# Autenticación (Security)
# ---------------------------------------------------------
# Secreto usado para firmar tokens JWT.
# SE GENERA AUTOMÁTICAMENTE AL ARRANCAR SI ESTÁ VACÍO.
JWT_SECRET=""


# ---------------------------------------------------------
# Configuración de Servidor API (Opcional - FastAPI/Uvicorn)
# ---------------------------------------------------------
# Puertos y hosts por si decides leerlos desde tu main.py en un script custom
HOST="127.0.0.1"
PORT=8400
ENVIRONMENT="development" # development, staging, production


# ---------------------------------------------------------
# Configuración de CORS / Frontend / Cloudflare
# ---------------------------------------------------------
# Orígenes permitidos (URL de tu frontend)
ALLOWED_ORIGINS="http://localhost:5173,https://tu-pos.com"
# Hosts permitidos (URL de tu backend)
ALLOWED_HOSTS="localhost,127.0.0.1,api.tu-pos.com"

# URL de la API para el build del Frontend (SvelteKit)
PUBLIC_API_URL="http://localhost:8000"



