# ==========================================
# Configuración de Entorno Ejemplar (Template)
# ==========================================
# Copia este archivo y renómbralo a `.env` 
# luego reemplaza los valores antes de correr la API o pasar a producción.

# ---------------------------------------------------------
# Base de Datos
# ---------------------------------------------------------
# URL de conexión a la base de datos de SQLAlchemy. 
# Si usas SQLite local, puedes dejarlo así:
DATABASE_URL="sqlite+aiosqlite:///./pos_database.db"

# Para usar PostgreSQL en producción, cambiaría a algo como:
# DATABASE_URL="postgresql+asyncpg://usuario:contraseña@localhost/blackshot_db"


# ---------------------------------------------------------
# Autenticación (OmniAuth Security)
# ---------------------------------------------------------
# Semilla maestra ("Seed") usada por el Vault para cifrar las identidades.
# CÁMBIA ESTO POR UNA CADENA LARGA Y SEGURA EN PRODUCCIÓN.
OMNIVAULT_SEED="omnisuite-sovereign-identity-seed"

# Token maestro o "Super Admin Token".
# Se usa para poder realizar configuraciones iniciales o registrar al primer Admin.
OMNI_MASTER_TOKEN="tu-token-super-seguro-aqui"

# Métodos permitidos para autenticarse, separados por coma.
# Opciones disponibles por el módulo: token, password, otp (si lo configuras después)
OMNI_AUTH_METHODS="token,password"


# ---------------------------------------------------------
# Configuración de Servidor API (Opcional - FastAPI/Uvicorn)
# ---------------------------------------------------------
# Puertos y hosts por si decides leerlos desde tu main.py en un script custom
# HOST="127.0.0.1"
# PORT=8000
# ENVIRONMENT="development" # development, staging, production


# ---------------------------------------------------------
# Configuración de CORS / Frontend
# ---------------------------------------------------------
# Cuando conectes tu SvelteKit con la API, puedes definir aquí 
# qué orígenes tienen permisos. (Tendrás que programar en el main.py que lea esta variable)
# ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"
